# Public site origin used for canonical URLs, Open Graph, sitemap and robots.txt.
# Local development:
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Production:
# NUXT_PUBLIC_SITE_URL=https://wanfind.com

# Domestic static mirror for mainland China (CF-IPCountry=CN). Leave empty locally.
# NUXT_PUBLIC_CN_ASSET_CDN=https://wan.zzf.net.cn

# Admin (required for /admin and review APIs)
NUXT_ADMIN_PASSWORD=change-me
NUXT_ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
