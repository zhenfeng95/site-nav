{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "site-nav",
    "compatibility_date": "2025-07-15",
    "compatibility_flags": ["nodejs_compat"],
    "observability": {
        "enabled": true,
    },
    "vars": {
        "NUXT_PUBLIC_SITE_URL": "https://wanfind.com",
        "NUXT_GITHUB_REPORTS_OWNER": "zhenfeng95",
        "NUXT_GITHUB_REPORTS_REPO": "site-nav",
        "NUXT_GITHUB_REPORTS_REF": "main",
    },
    // 首次部署先不绑自定义域名；Worker 稳定后再在控制台添加，或取消注释后重新 deploy：
    "routes": [
        {
            "pattern": "wanfind.com",
            "custom_domain": true,
        },
        {
            "pattern": "www.wanfind.com",
            "custom_domain": true,
        },
    ],
}
